{
  "version": "0.0.1",
  "id": "paralyzing_mist",
  "name": "Paralyzing Mist",
  "description": "Upon entering battle, the dragon releases a toxic mist that disrupts enemy nervous systems, slowing or paralyzing those caught inside."
  "type": "passive",
  "requirements": {
    "when": "hasAnyTag(self, ['toxic','venomous']) && hasItem(self, 'toxin_canister')"
  },
  "events": [
    {
      "event": "onBattleEnter",
      "oncePerBattle": false,
      "chance": "clamp(0.6 + self.stats.control * 0.05 - battle.avgEnemy.statusResistance * 0.03, 0.25, 0.95)",
      "effects": [
        {
          "effectId": "area_apply_status",
          "target": "enemy",
          "parameters": {
            "status": "paralysis",
            "duration": "clamp(5 * (1 + self.stats.firepower * 0.10) * (1 + self.level * 0.02) * (contains(battle.weather, \"rain\") ? 0.6 : 1.0) * (1 - target.stats.statusResistance), 2, 12)",
            "resistType": [
              "toxic",
              "poison"
            ]
          }
        }
      ]
    }
  ],
  "metadata": {
    "introducedIn": "1.0.0",
    "lastUpdated": "2025-12-28"
  }
}
